# Copy to .env.local and fill in your values
CLICKUP_TOKEN=pk_your_token_here

# Required to unlock editing (create / update / delete tasks).
# The app is publicly readable; mutations require this PIN.
ADMIN_PIN=your_admin_pin_here

# Calendar used for on-time / activity day bucketing (IANA name).
# Defaults to Asia/Ulaanbaatar so local and deploy grades match.
# APP_TIMEZONE=Asia/Ulaanbaatar
